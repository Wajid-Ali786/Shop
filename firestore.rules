rules_version = '2';

// =============================================================
//  Karyana Shop — Firestore Security Rules
//
//  YE RULES LAGANA LAZMI HAI.
//
//  Firebase ka web config (apiKey wagera) chhupa nahi hota — website ke
//  source me har kisi ko nazar aata hai. Aap ka data in rules se mehfooz
//  hota hai, config chhupane se nahi.
//
//  Ye rules kehti hain: har shakhs sirf APNA shop data parh aur likh
//  sakta hai (jahan document ka id us ke apne user id se milta ho).
//
//  Lagane ka tareeqa: Firebase Console → Firestore Database → Rules
//  → sab kuch replace kar ke Publish dabayein.
// =============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------
    //  shops/{uid} — dukandar ka apna sab kuch.
    //
    //  Pehle yahan sirf ek `match /{document=**}` tha jo maalik ko har cheez
    //  likhne deta tha. Ijazat to theek hai, magar JAANCH koi nahi thi: app me
    //  bug ho, ya koi seedha Firestore par likhe, to manfi stock ya harf wali
    //  qeemat bhi qubool ho jati thi — aur wo kharabi hamesha ke liye data me
    //  baith jati.
    //
    //  Ab har collection ka apna qanoon hai. Wildcard jaan boojh kar HATA diya
    //  gaya hai: Firestore me agar koi bhi match ijazat de de to kaam ho jata
    //  hai, yaani ek khula wildcard neeche ki saari jaanch bay-kaar kar deta.
    //  Is ka matlab ye bhi hai ke nayi collection banate waqt yahan qanoon
    //  likhna parega — aur bhoolne par likhai FORAN rukegi, chup chaap ghalat
    //  data nahi banega.
    // -----------------------------------------------------------------
    match /shops/{uid} {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }

      // Khali chhora ja sakta hai, magar likha ho to adad ho aur manfi na ho.
      function amountOk(data, f) {
        return !(f in data) || data[f] == null
          || (data[f] is number && data[f] >= 0);
      }

      // Shop ka apna document (settings).
      allow read, write: if owner();

      match /products/{id} {
        allow read, delete: if owner();
        allow create, update: if owner()
          && request.resource.data.nameEn is string
          && amountOk(request.resource.data, 'stockQty')
          && amountOk(request.resource.data, 'salePrice')
          && amountOk(request.resource.data, 'costPrice')
          && amountOk(request.resource.data, 'lowStockAt');
      }

      match /movements/{id} {
        allow read, delete: if owner();
        allow create, update: if owner()
          && amountOk(request.resource.data, 'qty');
      }

      match /khataParties/{id} {
        allow read, delete: if owner();
        // Balance manfi ho sakta hai (dukandar ne dena ho), is liye sirf itna
        // ke wo adad ho — nishan par pabandi ghalat hogi.
        allow create, update: if owner()
          && request.resource.data.name is string
          && (!('balance' in request.resource.data)
              || request.resource.data.balance is number)
          && (!('deposit' in request.resource.data)
              || request.resource.data.deposit is number)
          && amountOk(request.resource.data, 'creditLimit');
      }

      match /khataEntries/{id} {
        allow read, delete: if owner();
        allow create, update: if owner()
          && amountOk(request.resource.data, 'amount');
      }

      // In par koi khaas jaanch nahi banti — sirf maalik ki shart.
      match /categories/{id} { allow read, write: if owner(); }
      match /khataCategories/{id} { allow read, write: if owner(); }
      match /images/{id} { allow read, write: if owner(); }
      match /sales/{id} { allow read, write: if owner(); }
    }

    // ---------------------------------------------------------------
    //  Public catalog — grahak ke liye, bina login ke.
    //
    //  Ye dukan ke ASAL products NAHI hain. Ye un ki chhoti copy hai jis me
    //  sirf naam, tasveer aur bikri ka rate hota hai. Khareed rate, thok rate
    //  aur stock ki ginti kabhi yahan nahi likhi jati — wo `shops/{uid}` me
    //  rehti hain, jahan sirf dukandar pahunch sakta hai.
    //
    //  Parhna har koi sakta hai; likhna sirf usi dukan ka malik.
    // ---------------------------------------------------------------
    match /publicShops/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;

      match /{document=**} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Home page kis dukan ka catalog dikhaye — ek hi ishara.
    //
    // Pehle jo dukan ise apne naam kar le wahi aage badal sakti hai. Is se
    // koi doosra shakhs (signup khula hua hai) home page apni dukan par nahi
    // mor sakta.
    match /publicIndex/default {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Baqi har cheez band.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
